{
  "name": "minarvabiz",
  "version": "0.1.0",
  "private": true,
  "description": "MINARVA BIZ \u2014 Commercial Boutique Billing & Management Software (Online / Offline / Hybrid)",
  "author": "Evertek IT Solutions",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@minarvabiz/web",
    "dev:desktop": "turbo run dev --filter=@minarvabiz/desktop",
    "dev:license-admin": "turbo run dev --filter=@minarvabiz/license-admin",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "build:web": "turbo run build --filter=@minarvabiz/web",
    "typecheck:web": "pnpm --filter @minarvabiz/web exec tsc --noEmit",
    "check": "pnpm typecheck:web && pnpm build:web",
    "postinstall": "node scripts/ensure-native-bins.mjs || true",
    "desktop:install": "pnpm install && pnpm --filter @minarvabiz/desktop add -D electron@33.2.1 vite@6.0.3 electron-builder@24.13.3",
    "desktop:package": "pnpm --filter @minarvabiz/desktop run package:win"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "app-builder-bin",
      "electron-winstaller",
      "7zip-bin",
      "@parcel/watcher",
      "sharp",
      "node-gyp"
    ]
  }
}
