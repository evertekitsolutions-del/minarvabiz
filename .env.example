# MINARVA BIZ — Environment Configuration
# Copy to .env and fill values. NEVER commit .env or real secrets.

NODE_ENV=development
APP_NAME=Minarva Biz
APP_VERSION=1.0.4
APP_URL=http://localhost:3000
APP_EDITION=hybrid

# Production Supabase project created for Minarva Biz.
# This URL is safe to publish; keys/secrets below are not.
NEXT_PUBLIC_SUPABASE_URL=https://wmjgefbaliuwmaxyzxkq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional modern publishable key used by server-side license-admin password authentication.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=
SUPABASE_URL=https://wmjgefbaliuwmaxyzxkq.supabase.co
DATABASE_URL=postgresql://postgres:password@db.wmjgefbaliuwmaxyzxkq.supabase.co:5432/postgres

# Licensing (Ed25519)
# Generate keypair: pnpm --filter @minarvabiz/licensing generate-keys
# PRIVATE key stays only on the license-admin/server side.
LICENSE_PUBLIC_KEY=
LICENSE_PRIVATE_KEY=
# Public verification key only; safe to bundle into the desktop application at build time.
MINARVA_LICENSE_PUBLIC_KEY_HEX=
LICENSE_ADMIN_URL=http://localhost:3001
# Primary license-admin sign-in uses Supabase Auth email/password plus an active public.license_admin_identities row.
# TOTP MFA (AAL2) is mandatory before a named administrator session is issued.
# Create administrators in Supabase Auth, then allowlist the auth user UUID in the named-identities migration table.
# Break-glass shared-secret admin access is disabled by default. Enable only during an emergency access window.
LICENSE_ADMIN_EMERGENCY_LOGIN_ENABLED=false
# Emergency sessions must still identify a named human actor.
LICENSE_ADMIN_EMERGENCY_ACTOR_EMAIL=
LICENSE_ADMIN_EMERGENCY_ACTOR_NAME=
# Current emergency credential. Minimum 32 characters. Do not reuse it for session signing.
LICENSE_API_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Rotation grace only: place the OLD credential here and set an ISO-8601 expiry no more than 24 hours ahead.
# Clear both values after the rotation window ends.
LICENSE_API_SECRET_PREVIOUS=
LICENSE_API_SECRET_PREVIOUS_VALID_UNTIL=
# Independent server-only secrets for signed per-session cookies and persistent API rate-limit key hashing.
LICENSE_SESSION_SECRET=change-me-to-a-different-long-random-string
# Named admin sessions default to 30 minutes; accepted range is 300-3600 seconds.
# Emergency break-glass sessions are always capped at 15 minutes.
LICENSE_ADMIN_SESSION_TTL_SECONDS=1800
LICENSE_RATE_LIMIT_SECRET=change-me-to-another-long-random-string

# Desktop -> HTTPS license API. Set this to the deployed /api/license base URL.
VITE_LICENSE_API_URL=
MINARVA_LICENSE_API_URL=

# Optional signed Windows update channel.
# Both values are required to enable update checks. Manifest/install URLs must use HTTPS.
# The public key is Ed25519 raw public key hex (32 bytes / 64 hex chars). Keep the signing PRIVATE key off clients/Git.
MINARVA_UPDATE_MANIFEST_URL=
MINARVA_UPDATE_PUBLIC_KEY_HEX=

RESEND_API_KEY=
TRIAL_NOTIFICATION_FROM=

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-or-base64-key

DESKTOP_DATA_DIR=minarvabiz-data
VITE_DEV_SERVER_URL=http://localhost:5173
# Comma-separated hostnames allowed to open in the OS browser from Electron. HTTPS only; empty denies all external launches.
MINARVA_EXTERNAL_URL_HOSTS=

ENABLE_SYNC=true
ENABLE_NOTIFICATIONS=false
ENABLE_MULTI_BRANCH=false
LOG_LEVEL=info

# Production checklist
# - Rotate all secrets before go-live
# - Set NODE_ENV=production
# - Use managed Supabase secrets, not this file
# - Never embed LICENSE_PRIVATE_KEY in web or desktop builds
# - Never embed SUPABASE_SECRET_KEY / SERVICE_ROLE_KEY / RESEND_API_KEY in desktop builds
# - Bundle MINARVA_LICENSE_PUBLIC_KEY_HEX into the packaged desktop build; do not depend on .env at customer runtime
# - Set VITE_LICENSE_API_URL or MINARVA_LICENSE_API_URL to the production HTTPS license API
# - Configure LICENSE_PRIVATE_KEY only in the server/admin secret store
# - Provision each license administrator as a Supabase Auth user plus an active public.license_admin_identities row
# - Enroll TOTP MFA for every named administrator; first sign-in will require setup when no verified TOTP factor exists
# - Keep administrator sessions short; LICENSE_ADMIN_SESSION_TTL_SECONDS is clamped to 5-60 minutes and emergency sessions to 15 minutes
# - Keep LICENSE_ADMIN_EMERGENCY_LOGIN_ENABLED=false during normal operation; enable it only for break-glass access
# - If emergency access is enabled, set LICENSE_ADMIN_EMERGENCY_ACTOR_EMAIL and LICENSE_ADMIN_EMERGENCY_ACTOR_NAME to the person using it
# - During LICENSE_API_SECRET rotation, accept the old secret only via LICENSE_API_SECRET_PREVIOUS with a <=24h expiry
# - Keep LICENSE_SESSION_SECRET and LICENSE_RATE_LIMIT_SECRET server-only and distinct from LICENSE_API_SECRET
# - If Windows auto-update is enabled, sign every update manifest offline/server-side and bundle only MINARVA_UPDATE_PUBLIC_KEY_HEX
# - Verify the email-sending domain in Resend before production use

NEXT_PUBLIC_REQUIRE_AUTH=false
MINARVA_MODE=development
NEXT_PUBLIC_MINARVA_MODE=development
MINARVA_SQLITE_PATH=
