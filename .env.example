# MINARVA BIZ — Environment Configuration
# Copy to .env and fill values. NEVER commit .env or real secrets.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Minarva Biz
APP_VERSION=0.1.0
APP_URL=http://localhost:3000
# online | offline | hybrid
APP_EDITION=hybrid

# -----------------------------------------------------------------------------
# Supabase / PostgreSQL (Online + Hybrid cloud)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Licensing (Ed25519)
# Generate keypair: pnpm --filter @minarvabiz/licensing generate-keys
# Only PUBLIC key is used in client apps. PRIVATE key stays on license-admin server.
# -----------------------------------------------------------------------------
LICENSE_PUBLIC_KEY=
LICENSE_PRIVATE_KEY=
LICENSE_ADMIN_URL=http://localhost:3001
LICENSE_API_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# -----------------------------------------------------------------------------
# Auth / crypto
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-or-base64-key

# -----------------------------------------------------------------------------
# Desktop (Electron)
# -----------------------------------------------------------------------------
DESKTOP_DATA_DIR=minarvabiz-data
# Optional Vite dev server for Electron renderer
VITE_DEV_SERVER_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
ENABLE_SYNC=true
ENABLE_NOTIFICATIONS=false
ENABLE_MULTI_BRANCH=false
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Production checklist
# - Rotate all secrets before go-live
# - Set NODE_ENV=production
# - Use managed Supabase secrets, not this file
# - Never embed LICENSE_PRIVATE_KEY in web or desktop builds
# -----------------------------------------------------------------------------

# Set true to require login for app routes
NEXT_PUBLIC_REQUIRE_AUTH=false

# production | demo | development — demo enables seed data
MINARVA_MODE=development
NEXT_PUBLIC_MINARVA_MODE=development
MINARVA_SQLITE_PATH=
