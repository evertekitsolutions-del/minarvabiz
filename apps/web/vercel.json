{
  "framework": "nextjs",
  "buildCommand": "node scripts/vercel-build.mjs",
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "outputDirectory": ".next",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "staging": true
    }
  }
}
