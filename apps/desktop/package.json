{
  "name": "@minarvabiz/desktop",
  "version": "1.0.4",
  "private": true,
  "description": "Minarva Biz Offline / Hybrid Windows application",
  "author": "Evertek IT Solutions",
  "main": "electron/dist/bootstrap.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "prepare:license": "node scripts/write-license-config.mjs",
    "build:electron": "pnpm run prepare:license && tsc -p tsconfig.electron.json",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "typecheck": "pnpm run prepare:license && tsc --noEmit -p tsconfig.json",
    "package:win": "pnpm run build && electron-builder --win --x64 --config electron-builder.yml",
    "package": "pnpm run package:win"
  },
  "dependencies": {
    "@minarvabiz/business-logic": "workspace:*",
    "@minarvabiz/database": "workspace:*",
    "@minarvabiz/licensing": "workspace:*",
    "@minarvabiz/types": "workspace:*",
    "@minarvabiz/ui": "workspace:*",
    "@minarvabiz/utils": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vite": "^6.0.7"
  }
}
