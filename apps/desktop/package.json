{
  "name": "@minarvabiz/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Minarva Biz Offline / Hybrid Windows application",
  "author": "Evertek IT Solutions",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "package:win": "electron-builder --win --x64 --config electron-builder.yml",
    "package": "pnpm run build && pnpm run package:win"
  },
  "dependencies": {
    "@minarvabiz/business-logic": "workspace:*",
    "@minarvabiz/database": "workspace:*",
    "@minarvabiz/licensing": "workspace:*",
    "@minarvabiz/types": "workspace:*",
    "@minarvabiz/ui": "workspace:*",
    "@minarvabiz/utils": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
