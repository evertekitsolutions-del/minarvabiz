{
  "name": "@minarvabiz/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Minarva Biz Offline / Hybrid Windows application",
  "author": "Evertek IT Solutions",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "pnpm run build:renderer && pnpm run build:electron",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package:win": "pnpm run build && electron-builder --win --x64 --config electron-builder.yml",
    "package": "pnpm run package:win"
  },
  "dependencies": {
    "@minarvabiz/business-logic": "workspace:*",
    "@minarvabiz/database": "workspace:*",
    "@minarvabiz/licensing": "workspace:*",
    "@minarvabiz/types": "workspace:*",
    "@minarvabiz/ui": "workspace:*",
    "@minarvabiz/utils": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "app-builder-bin": "^4.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "33.2.1",
    "electron-builder": "24.13.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "6.0.3"
  }
}
