{
  "framework": "nextjs",
  "buildCommand": "pnpm --filter @minarvabiz/web build",
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "outputDirectory": "apps/web/.next",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "staging": true
    }
  }
}
